{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "The Grafana Cloud Prometheus (Mimir) data source receiving OTLP metrics.",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "title": "labqueue-api (public)",
  "uid": "labqueue-api-public",
  "description": "Public, read-only copy of the labqueue-api dashboard, pinned to the hosted environment. Grafana's external sharing does not support template variables, so the $env filter is replaced by a literal deployment_environment=\"hosted\" in every query. Derived from labqueue-api.json - see README.md in this directory.",
  "tags": ["labqueue", "public"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Request rate",
      "description": "Requests per second by route. /health is the container healthcheck and Render's probe; it is left in rather than filtered out, because a flat healthcheck line is the difference between an idle service and a dead one.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": { "fillOpacity": 8, "lineWidth": 2, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "editorMode": "code",
          "range": true,
          "expr": "sum by (http_route) (rate(http_server_request_duration_seconds_count{service_name=\"labqueue-api\", deployment_environment=\"hosted\"}[$__rate_interval]))",
          "legendFormat": "{{http_route}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Error rate",
      "description": "5xx is the failure line. 4xx is plotted separately and deliberately: a 409 here is the booking rules rejecting an overlapping window, which is the API working, not failing. Counting them together would make correct behaviour look like an outage.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": { "fillOpacity": 8, "lineWidth": 2, "showPoints": "never" }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "5xx — server errors" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          },
          {
            "matcher": { "id": "byName", "options": "4xx — client rejections (expected)" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "yellow" } }]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "editorMode": "code",
          "range": true,
          "expr": "sum(rate(http_server_request_duration_seconds_count{service_name=\"labqueue-api\", deployment_environment=\"hosted\", http_response_status_code=~\"5..\"}[$__rate_interval]))",
          "legendFormat": "5xx — server errors"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "editorMode": "code",
          "range": true,
          "expr": "sum(rate(http_server_request_duration_seconds_count{service_name=\"labqueue-api\", deployment_environment=\"hosted\", http_response_status_code=~\"4..\"}[$__rate_interval]))",
          "legendFormat": "4xx — client rejections (expected)"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Latency — P50 / P95 / P99",
      "description": "Quantiles over the ASP.NET Core request duration histogram, across all routes.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": { "fillOpacity": 0, "lineWidth": 2, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "editorMode": "code",
          "range": true,
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_server_request_duration_seconds_bucket{service_name=\"labqueue-api\", deployment_environment=\"hosted\"}[$__rate_interval])))",
          "legendFormat": "P50"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "editorMode": "code",
          "range": true,
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{service_name=\"labqueue-api\", deployment_environment=\"hosted\"}[$__rate_interval])))",
          "legendFormat": "P95"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "editorMode": "code",
          "range": true,
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_request_duration_seconds_bucket{service_name=\"labqueue-api\", deployment_environment=\"hosted\"}[$__rate_interval])))",
          "legendFormat": "P99"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Database query duration — P50 / P95 / P99",
      "description": "Npgsql's db.client.operation.duration. Aggregated over the connection-pool label on purpose: that label carries the database host and user, and this dashboard has a variable-free copy that is shared publicly.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": { "fillOpacity": 0, "lineWidth": 2, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "editorMode": "code",
          "range": true,
          "expr": "histogram_quantile(0.50, sum by (le) (rate(db_client_operation_duration_seconds_bucket{service_name=\"labqueue-api\", deployment_environment=\"hosted\"}[$__rate_interval])))",
          "legendFormat": "P50"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "editorMode": "code",
          "range": true,
          "expr": "histogram_quantile(0.95, sum by (le) (rate(db_client_operation_duration_seconds_bucket{service_name=\"labqueue-api\", deployment_environment=\"hosted\"}[$__rate_interval])))",
          "legendFormat": "P95"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "editorMode": "code",
          "range": true,
          "expr": "histogram_quantile(0.99, sum by (le) (rate(db_client_operation_duration_seconds_bucket{service_name=\"labqueue-api\", deployment_environment=\"hosted\"}[$__rate_interval])))",
          "legendFormat": "P99"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Booking conflicts — reservations.conflicts.total",
      "description": "Incremented every time the overlap check rejects a booking with 409. Only that check: a booking refused because the resource is retired or under maintenance is also a 409, and is deliberately not counted here.\n\nThis is the panel that makes Finding A visible. Under normal use it is near zero. When fifty concurrent requests contend for one slot, it spikes — and the number of bookings that survive is the finding.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 16 },
      "fieldConfig": {
        "defaults": {
          "unit": "cps",
          "min": 0,
          "custom": {
            "fillOpacity": 25,
            "lineWidth": 2,
            "showPoints": "auto",
            "gradientMode": "opacity"
          },
          "color": { "mode": "fixed", "fixedColor": "orange" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["max"] },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "editorMode": "code",
          "range": true,
          "expr": "sum(rate(reservations_conflicts_total{service_name=\"labqueue-api\", deployment_environment=\"hosted\"}[$__rate_interval]))",
          "legendFormat": "conflicts/sec"
        }
      ]
    }
  ]
}
