{
  "ConnectionStrings": {
    "LabQueue": "Host=localhost;Port=5432;Database=labqueue;Username=labqueue;Password=labqueue_dev"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ]
  },
  "Jwt": {
    "Issuer": "labqueue",
    "Audience": "labqueue",
    "TokenLifetimeHours": 2
  },
  "AllowedHosts": "*"
}
