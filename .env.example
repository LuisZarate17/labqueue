# Copy to .env for local development. .env is gitignored; this file is not.
# Nothing here is a real credential — every value is a local-only placeholder.

# --- docker-compose ---
POSTGRES_PASSWORD=labqueue_dev

# --- API ---
# The value below is for running the API on the host (dotnet run). The compose "api"
# service overrides it with Host=db, because localhost inside that container is not
# the database.
ConnectionStrings__LabQueue=Host=localhost;Port=5432;Database=labqueue;Username=labqueue;Password=labqueue_dev

# Must be at least 32 bytes. Generate one with:
#   openssl rand -base64 48
Jwt__Key=replace-with-at-least-32-bytes-of-random-material
Jwt__Issuer=labqueue
Jwt__Audience=labqueue

# --- migrations ---
# Used by scripts/db-migrate.ps1 -Target neon. Neon's DIRECT (non-pooled) endpoint,
# converted from their postgresql:// URI to Npgsql key-value form. The application uses
# the POOLED endpoint instead; only DDL goes through this one.
#   LABQUEUE_MIGRATION_CONNECTION=Host=ep-xxxx.us-east-2.aws.neon.tech;Database=labqueue;Username=labqueue_owner;Password=...;SSL Mode=Require

# --- demo seed ---
# Off unless set. When on, the API seeds a small demo dataset at boot — six resources, a
# maintenance window, a few upcoming bookings — and creates the demo account by hashing
# the password below at runtime, so no password hash is ever committed.
#
# This is NOT the benchmark seed. db/seed/*.sql builds the 500k-row measurement dataset
# and is only ever loaded into the local compose database.
#
# The member credentials are published — on the landing route and in the README. The admin
# pair is optional and is never published: creating a maintenance window blocks bookings on
# a resource, so a public admin login lets any visitor break the demo for everyone after them.
Demo__Seed=false
Demo__Email=demo@labqueue.dev
Demo__Password=replace-with-the-published-demo-password
Demo__DisplayName=Demo Researcher
# Demo__AdminEmail=ops@labqueue.dev
# Demo__AdminPassword=replace-with-something-you-do-not-publish

# --- OpenTelemetry -> Grafana Cloud ---
# Absent OTEL_EXPORTER_OTLP_ENDPOINT the app runs normally and exports nothing at all —
# no exporter is registered. That is what keeps CI free of both secrets and startup cost.
#
# Both environments report to ONE Grafana stack with the SAME service.name, distinguished
# only by OTEL_DEPLOYMENT_ENVIRONMENT. Every dashboard panel filters on it. Setting the
# endpoint without the environment is a startup error rather than a silent mislabelling,
# because unlabelled series are invisible under either filter.
#
# The header is Basic auth: base64 of "<instanceID>:<token>" from the Grafana Cloud portal.
#   OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-us-east-0.grafana.net/otlp
#   OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64 instanceID:token>
#   OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
#   OTEL_DEPLOYMENT_ENVIRONMENT=local

# Compose sets these two for the local environment; they are listed here for reference.
# 60s is the SDK default and too coarse to resolve a conflict spike in a short k6 run.
#   OTEL_METRIC_EXPORT_INTERVAL=15000
# Metrics stay complete; traces are sampled, so a load test does not flood the free quota.
#   OTEL_TRACES_SAMPLER=parentbased_traceidratio
#   OTEL_TRACES_SAMPLER_ARG=0.1
